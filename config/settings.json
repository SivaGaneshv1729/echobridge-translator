{
  "general": {
    "app_name": "EchoBridge",
    "version": "1.0.0",
    "source_language": "en",
    "target_language": "ja",
    "bidirectional_mode": true,
    "save_recordings": false,
    "conversation_history_enabled": true
  },
  "audio": {
    "sample_rate": 16000,
    "channels": 1,
    "chunk_size": 512,
    "input_device_index": null,
    "output_device_index": null,
    "auto_playback": true,
    "playback_volume": 1.0,
    "playback_speed": 1.0
  },
  "vad": {
    "engine": "silero",
    "threshold": 0.5,
    "min_speech_duration_ms": 250,
    "min_silence_duration_ms": 500,
    "speech_pad_ms": 100
  },
  "stt": {
    "engine": "faster-whisper",
    "model_size": "base",
    "compute_type": "int8",
    "cpu_threads": 4,
    "beam_size": 3,
    "best_of": 3,
    "patience": 1.0,
    "temperature": 0.0,
    "context_memory_turns": 5,
    "language_detection": true
  },
  "translation": {
    "engine": "argostranslate",
    "installed_pairs": [
      {
        "from": "en",
        "to": "ja"
      },
      {
        "from": "ja",
        "to": "en"
      }
    ]
  },
  "tts": {
    "engine": "piper",
    "voices": {
      "en": "en_US-amy-low",
      "ja": "ja_JP-hi_fi_captain-medium"
    },
    "length_scale": 1.0
  },
  "coach": {
    "provider": "groq",
    "groq_model": "qwen/qwen3.8-27b",
    "gemini_model": "gemini-2.5-flash",
    "api_keys_file": "config/api_keys.json",
    "rotation_enabled": true,
    "fallback_to_offline": true
  },
  "models_dir": "models_cache",
  "diagnostics": {
    "log_level": "INFO",
    "measure_latency": true
  }
}